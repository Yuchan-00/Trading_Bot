# ===== 실행 모드 =====
# paper(기본): 거래소 주문 없이 가상 체결 | testnet: Binance 테스트넷 주문 | live: 실계정 (CONFIRM_LIVE=YES + 콘솔에서 "LIVE" 입력 필요)
MODE=paper
CONFIRM_LIVE=NO

# ===== Claude API =====
# https://console.anthropic.com 에서 발급. 로그/텔레그램/LLM 입력에는 절대 노출되지 않음.
ANTHROPIC_API_KEY=
# 에이전트 백엔드: anthropic(기본) | mock(오프라인 테스트용, 결정 고정)
AGENT_BACKEND=anthropic
# AGENT_BACKEND=mock 일 때 Mock 응답 시나리오: conservative(기본, 진입 없음) | approve(paper 진입까지)
# 키 없이 체험(cmd·PowerShell·bash 공통): python -m tradingbot.main run --once --offline-fixture --mock-scenario approve
MOCK_SCENARIO=conservative
# 역할별 모델 (기본값: 분석=haiku, 리서치/리스크=sonnet, 총괄=opus)
MODEL_ANALYSIS=claude-haiku-5-5
MODEL_RESEARCH=claude-sonnet-5-5
MODEL_HEAD=claude-opus-5-5
# 비용 상한 (USD). 일일 상한 초과 시 LLM 호출을 멈추고 HOLD (코드 손절/익절은 계속 집행)
LLM_DAILY_BUDGET_USD=10
LLM_MONTHLY_BUDGET_USD=200

# ===== Binance =====
# 테스트넷 키: https://testnet.binance.vision
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
# 실계정 키 (MODE=live 에서만 사용)
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=

# ===== 텔레그램 (모든 거래 이벤트 알림) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== 전략/운용 =====
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT
CYCLE_MINUTES=15
PAPER_START_BALANCE_USDT=10000
MAX_CANDIDATES_PER_CYCLE=2

# ===== 대시보드 =====
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787

# ===== 파일·로그 =====
# 이 파일은 메모장에서 UTF-8 로 저장하세요. PowerShell 의 > · >> 로 만들거나 덧붙이지 마세요
# (> 는 UTF-16 으로 저장 — 경고 후 읽음. >> 나 cmd 로 덧붙여 인코딩이 섞이면 봇이 그 줄을 알려 주고 시작하지 않음).
# 상태·로그 폴더(기본: 봇을 실행한 폴더). Windows 경로는 따옴표 없이 쓰거나 / 를 쓰세요: DATA_DIR=B:/TradingBot/data
# (큰따옴표 안의 \t \b \n 은 특수문자로 바뀌고, %USERPROFILE% 같은 cmd 변수는 펼쳐지지 않습니다)
# DATA_DIR=
# 로그 파일(DATA_DIR 기준 상대 경로, UTF-8). 끄려면 LOG_FILE=none
LOG_FILE=logs/bot.log
